					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Clears the user session and token cookies."
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Admin Dashboard (Protected)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/admin/dashboard",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"admin",
								"dashboard"
							]
						},
						"description": "Succeeds only if a valid ADMIN JWT token is supplied."
					},
					"response": []
				}
			]
		}
