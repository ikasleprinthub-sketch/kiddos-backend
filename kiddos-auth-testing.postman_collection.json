						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"johndoe@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/forgot-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"forgot-password"
							]
						},
						"description": "Requests a password reset. Dispatches a 6-digit reset OTP email."
					},
					"response": []
				},
				{
					"name": "Verify Reset OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-reset-otp",
							"host": [
								"{{base_url}}"
