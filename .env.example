NODE_ENV=development
PORT=5050
BACKEND_URL=http://localhost:5050
CORS_ORIGIN=http://localhost:3030
FRONTEND_URL=http://localhost:3030

DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Uploaded images ------------------------------------------------------
# Both writing (/api/upload) and serving (/uploads/...) use this directory.
# Relative paths resolve from the backend folder; absolute paths are used as-is.
#   Local dev (Windows/macOS/Linux): ./uploads
#   Production (Linux server):       /var/www/kiddosfoods/uploads  (persistent, outside the app folder,
#                                    so deploys don't wipe it; owned by the user running the app)
#   Docker:                          ignored — the container always uses /app/uploads; choose the HOST
#                                    folder mounted there with UPLOAD_HOST_DIR below.
# Image URLs are stored in the DB as relative paths (/uploads/<folder>/<file>), never with a host.
UPLOAD_DIR=./uploads
# docker-compose.yml only: host folder mounted at /app/uploads (default ./public/uploads).
# Production Docker: /var/www/kiddosfoods/uploads   Local Docker: ./uploads (shares files with `npm run dev`)
UPLOAD_HOST_DIR=./uploads

# --- Anonymous franchise photo uploads -----------------------------------
# Number of proxies in front of the app that APPEND the client address to X-Forwarded-For
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;). 0 = trust no forwarded
# header: all anonymous uploads then share one limit. Only set this if the app's port is reachable
# solely through those proxies, otherwise clients could forge their IP.
TRUSTED_PROXY_HOPS=0
# Limits (stored in the database, shared by all instances):
# per client per 15 minutes, and for all anonymous uploads together per hour
FRANCHISE_UPLOAD_LIMIT_PER_CLIENT=10
FRANCHISE_UPLOAD_LIMIT_GLOBAL=100

# --- Email (SMTP) --------------------------------------------------------
# Gmail: enable 2-step verification and create an App Password (not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Kiddos Foods
SMTP_FROM_EMAIL=

# Admin inbox that receives new-order mails and every website form submission
# (contact, franchise inquiry, franchise brochure/form download). Comma-separate for several.
ADMIN_NOTIFICATION_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

GOOGLE_CLIENT_ID=
